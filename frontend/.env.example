# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate` (Project Settings > Database > Connection string)
SUPABASE_DB_URL=

# --- Hedera ---
HEDERA_NETWORK=testnet
# Treasury key: ECDSA secp256k1, hex. Server-only; never prefix with NEXT_PUBLIC_.
HEDERA_OPERATOR_KEY=
# Filled in by `npm run setup:hedera`:
HEDERA_OPERATOR_ID=
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_TREASURY_ACCOUNT_ID=
NEXT_PUBLIC_HCS_TOPIC_ID=
NEXT_PUBLIC_CO2E_TOKEN_ID=
NEXT_PUBLIC_CERTIFICATE_TOKEN_ID=
NEXT_PUBLIC_EXCHANGE_CONTRACT_ID=
NEXT_PUBLIC_EXCHANGE_CONTRACT_ADDRESS=
# Shared secret between this app and the backend listener (generated by setup:hedera)
INTERNAL_API_SECRET=

# --- AI provider: set one ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# Cheaper model for bill reading (transcription); defaults to OPENAI_MODEL
# OPENAI_EXTRACTION_MODEL=gpt-5.4-mini

# --- IPFS pinning (optional; without it metadata is content-addressed and served by the app) ---
PINATA_JWT=
