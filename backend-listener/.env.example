# URL of the deployed GreenTrace app (no trailing slash)
APP_URL=http://localhost:3000
# Must equal INTERNAL_API_SECRET in the app's environment
INTERNAL_API_SECRET=
# GreenTraceExchange contract id (NEXT_PUBLIC_EXCHANGE_CONTRACT_ID in the app)
EXCHANGE_CONTRACT_ID=
HEDERA_NETWORK=testnet
# Optional
# POLL_INTERVAL_MS=5000
# LOOKBACK_SECONDS=3600
